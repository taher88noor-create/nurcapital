# ─────────────────────────────────────────────────────────────
# Nür Capital — Environment Variables
# ─────────────────────────────────────────────────────────────

# ── FRONTEND (Netlify) ────────────────────────────────────────
# Set this in Netlify dashboard → Site settings → Environment variables
NEXT_PUBLIC_API_URL=https://your-app-name.onrender.com

# ── BACKEND (Render) ─────────────────────────────────────────
# Set this in Render dashboard → Environment
CORS_ORIGINS=https://your-app-name.netlify.app

# Optional: Twelve Data fallback provider (not required for MVP)
# TWELVE_DATA_API_KEY=your_key_here
